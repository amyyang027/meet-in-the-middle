\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Small instances. Model A gets a 90-second limit per instance. For $N\le 18$ it finishes, and Model B matches its proven optimum in 9 of 10 instances. For $N\ge 24$ Model A hits the time limit every time, while Model B stays within about 1\% of the bound in seconds.}}{5}{table.caption.2}\protected@file@percent }
\newlabel{tab:e1}{{1}{5}{Small instances. Model A gets a 90-second limit per instance. For $N\le 18$ it finishes, and Model B matches its proven optimum in 9 of 10 instances. For $N\ge 24$ Model A hits the time limit every time, while Model B stays within about 1\% of the bound in seconds}{table.caption.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces (a) Share of the certified upper bound achieved, averaged over 5 instances per $N$ (Random averages between $-7\%$ and $24\%$; a negative average is drawn at 0). (b) Mean solve time; Model A is stopped at 300 seconds. (c) One run of column generation at $N=30$: the restricted master LP climbs to the full LP optimum in 22 iterations using 312 of the roughly 350{,}000 possible tables, and exact pricing then certifies it as an upper bound.}}{5}{figure.caption.3}\protected@file@percent }
\newlabel{fig:qsc}{{2}{5}{(a) Share of the certified upper bound achieved, averaged over 5 instances per $N$ (Random averages between $-7\%$ and $24\%$; a negative average is drawn at 0). (b) Mean solve time; Model A is stopped at 300 seconds. (c) One run of column generation at $N=30$: the restricted master LP climbs to the full LP optimum in 22 iterations using 312 of the roughly 350{,}000 possible tables, and exact pricing then certifies it as an upper bound}{figure.caption.3}{}}
